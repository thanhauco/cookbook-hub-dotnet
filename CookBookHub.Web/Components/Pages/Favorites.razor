@page "/favorites"
@using CookBookHub.Web.Components.Layout

<PageTitle>My Favorites - CookBook Hub</PageTitle>

<div class="favorites-page">
    <div class="page-header">
        <h1>My Favorite Recipes</h1>
        <p>Your saved recipes in one place</p>
    </div>

    <div class="favorites-grid">
        @for (int i = 0; i < 8; i++)
        {
            <div class="recipe-card">
                <div class="recipe-image">
                    <img src="https://via.placeholder.com/350x250" alt="Recipe" />
                    <button class="btn-favorite active">❤️</button>
                </div>
                <div class="recipe-content">
                    <h3>Favorite Recipe @(i + 1)</h3>
                    <p class="recipe-description">A delicious recipe you've saved for later</p>
                    <div class="recipe-stats">
                        <span>⏱️ 30 min</span>
                        <span>⭐ 4.8</span>
                    </div>
                    <div class="recipe-footer">
                        <span class="recipe-author">by @@chef_name</span>
                        <span class="recipe-category">Italian</span>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<style>
    .favorites-page {
        max-width: 1400px;
        margin: 0 auto;
        padding: 2rem;
    }

    .page-header {
        text-align: center;
        margin-bottom: 3rem;
    }

    .page-header h1 {
        font-size: 2.5rem;
        color: #2d3748;
        margin-bottom: 0.5rem;
    }

    .page-header p {
        font-size: 1.125rem;
        color: #6b7280;
    }

    .favorites-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
        gap: 2rem;
    }

    .recipe-card {
        background: white;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
        transition: all 0.3s;
        cursor: pointer;
    }

    .recipe-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.15);
    }

    .recipe-image {
        position: relative;
        height: 250px;
        overflow: hidden;
    }

    .recipe-image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.3s;
    }

    .recipe-card:hover .recipe-image img {
        transform: scale(1.1);
    }

    .btn-favorite {
        position: absolute;
        top: 1rem;
        right: 1rem;
        width: 44px;
        height: 44px;
        border: none;
        background: white;
        border-radius: 50%;
        font-size: 1.25rem;
        cursor: pointer;
        transition: all 0.2s;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
    }

    .btn-favorite.active {
        background: #ef4444;
        color: white;
    }

    .btn-favorite:hover {
        transform: scale(1.1);
    }

    .recipe-content {
        padding: 1.5rem;
    }

    .recipe-content h3 {
        font-size: 1.25rem;
        color: #2d3748;
        margin-bottom: 0.5rem;
    }

    .recipe-description {
        color: #6b7280;
        font-size: 0.875rem;
        margin-bottom: 1rem;
        line-height: 1.5;
    }

    .recipe-stats {
        display: flex;
        gap: 1rem;
        margin-bottom: 1rem;
        font-size: 0.875rem;
        color: #6b7280;
    }

    .recipe-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding-top: 1rem;
        border-top: 1px solid #e5e7eb;
    }

    .recipe-author {
        font-size: 0.875rem;
        color: #9ca3af;
    }

    .recipe-category {
        font-size: 0.75rem;
        padding: 0.25rem 0.75rem;
        background: #667eea;
        color: white;
        border-radius: 12px;
    }
</style>

