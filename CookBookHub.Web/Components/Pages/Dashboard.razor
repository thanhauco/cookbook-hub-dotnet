@page "/dashboard"
@using CookBookHub.Web.Components.Layout

<PageTitle>Dashboard - CookBook Hub</PageTitle>

<div class="dashboard-page">
    <div class="page-header">
        <h1>Dashboard</h1>
        <p>Welcome back, chef_mario!</p>
    </div>

    <div class="stats-grid">
        <div class="stat-card">
            <div class="stat-icon">📖</div>
            <div class="stat-content">
                <h3>48</h3>
                <p>Your Recipes</p>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon">⭐</div>
            <div class="stat-content">
                <h3>4.8</h3>
                <p>Avg Rating</p>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon">👥</div>
            <div class="stat-content">
                <h3>1.2K</h3>
                <p>Followers</p>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon">❤️</div>
            <div class="stat-content">
                <h3>892</h3>
                <p>Total Likes</p>
            </div>
        </div>
    </div>

    <div class="dashboard-content">
        <div class="dashboard-main">
            <div class="section">
                <div class="section-header">
                    <h2>Recent Recipes</h2>
                    <a href="/recipes" class="link-view-all">View All →</a>
                </div>
                <div class="recipe-list">
                    @for (int i = 0; i < 3; i++)
                    {
                        <div class="recipe-item">
                            <img src="https://via.placeholder.com/100x80" alt="Recipe" />
                            <div class="recipe-item-info">
                                <h4>Recipe Title @(i + 1)</h4>
                                <p>Created 2 days ago • ⭐ 4.8 (24 reviews)</p>
                            </div>
                            <div class="recipe-item-actions">
                                <button class="btn-icon">✏️</button>
                                <button class="btn-icon">🗑️</button>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <div class="section">
                <div class="section-header">
                    <h2>Recent Reviews</h2>
                </div>
                <div class="review-list">
                    @for (int i = 0; i < 3; i++)
                    {
                        <div class="review-item">
                            <div class="review-header">
                                <div class="reviewer-avatar">JS</div>
                                <div>
                                    <strong>@@john_smith</strong>
                                    <p>on Classic Spaghetti Carbonara</p>
                                </div>
                            </div>
                            <div class="review-rating">⭐⭐⭐⭐⭐</div>
                            <p>Absolutely delicious! Best carbonara I've ever made.</p>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="dashboard-sidebar">
            <div class="sidebar-card">
                <h3>Quick Actions</h3>
                <div class="quick-actions">
                    <a href="/create-recipe" class="action-btn">➕ New Recipe</a>
                    <a href="/profile/chef_mario" class="action-btn">👤 View Profile</a>
                    <a href="/settings" class="action-btn">⚙️ Settings</a>
                </div>
            </div>

            <div class="sidebar-card">
                <h3>Popular Categories</h3>
                <div class="category-list">
                    <div class="category-item">
                        <span>🍝 Italian</span>
                        <span class="badge">12</span>
                    </div>
                    <div class="category-item">
                        <span>🍜 Asian</span>
                        <span class="badge">8</span>
                    </div>
                    <div class="category-item">
                        <span>🥗 Healthy</span>
                        <span class="badge">15</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .dashboard-page {
        max-width: 1400px;
        margin: 0 auto;
        padding: 2rem;
    }

    .page-header {
        margin-bottom: 2rem;
    }

    .page-header h1 {
        font-size: 2.5rem;
        color: #2d3748;
        margin-bottom: 0.5rem;
    }

    .page-header p {
        font-size: 1.125rem;
        color: #6b7280;
    }

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 1.5rem;
        margin-bottom: 3rem;
    }

    .stat-card {
        background: white;
        padding: 1.5rem;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
        display: flex;
        align-items: center;
        gap: 1rem;
    }

    .stat-icon {
        font-size: 2.5rem;
    }

    .stat-content h3 {
        font-size: 2rem;
        color: #2d3748;
        margin-bottom: 0.25rem;
    }

    .stat-content p {
        color: #6b7280;
        font-size: 0.875rem;
    }

    .dashboard-content {
        display: grid;
        grid-template-columns: 2fr 1fr;
        gap: 2rem;
    }

    .section {
        background: white;
        padding: 1.5rem;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
        margin-bottom: 2rem;
    }

    .section-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1.5rem;
    }

    .section-header h2 {
        font-size: 1.5rem;
        color: #2d3748;
    }

    .link-view-all {
        color: #667eea;
        text-decoration: none;
        font-weight: 600;
    }

    .recipe-list, .review-list {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .recipe-item {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 1rem;
        background: #f9fafb;
        border-radius: 8px;
    }

    .recipe-item img {
        width: 100px;
        height: 80px;
        object-fit: cover;
        border-radius: 8px;
    }

    .recipe-item-info {
        flex: 1;
    }

    .recipe-item-info h4 {
        font-size: 1.125rem;
        color: #2d3748;
        margin-bottom: 0.25rem;
    }

    .recipe-item-info p {
        font-size: 0.875rem;
        color: #6b7280;
    }

    .recipe-item-actions {
        display: flex;
        gap: 0.5rem;
    }

    .btn-icon {
        width: 36px;
        height: 36px;
        border: none;
        background: white;
        border-radius: 6px;
        cursor: pointer;
        transition: all 0.2s;
    }

    .btn-icon:hover {
        background: #e5e7eb;
    }

    .review-item {
        padding: 1rem;
        background: #f9fafb;
        border-radius: 8px;
    }

    .review-header {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin-bottom: 0.75rem;
    }

    .reviewer-avatar {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: #667eea;
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 600;
        font-size: 0.875rem;
    }

    .review-rating {
        margin-bottom: 0.5rem;
    }

    .sidebar-card {
        background: white;
        padding: 1.5rem;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
        margin-bottom: 1.5rem;
    }

    .sidebar-card h3 {
        font-size: 1.125rem;
        color: #2d3748;
        margin-bottom: 1rem;
    }

    .quick-actions {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    .action-btn {
        padding: 0.75rem 1rem;
        background: #f3f4f6;
        border-radius: 8px;
        text-decoration: none;
        color: #2d3748;
        font-weight: 500;
        transition: all 0.2s;
    }

    .action-btn:hover {
        background: #e5e7eb;
    }

    .category-list {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    .category-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0.75rem;
        background: #f9fafb;
        border-radius: 8px;
    }

    .badge {
        background: #667eea;
        color: white;
        padding: 0.25rem 0.75rem;
        border-radius: 12px;
        font-size: 0.75rem;
        font-weight: 600;
    }
</style>

